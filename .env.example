# Sao chép thành .env tại gốc monorepo cho môi trường local.
NODE_ENV=development
POSTGRES_PASSWORD=replace-this-with-a-private-random-db-password
DATABASE_URL=postgres://sakura:replace-this-with-a-private-random-db-password@localhost:5435/neon_sakura
API_PORT=4000
WORLD_PORT=2567
# Nhiều origin cách nhau bởi dấu phẩy. Chơi 2 máy qua Tailscale: thêm https://<máy-chủ>.<tailnet>.ts.net
# (xem docs/reports/VOICE_PROXIMITY_REPORT.md).
CORS_ORIGIN=http://localhost:3000
# Web tự suy ra URL khi không đặt: trang http -> http://<host>:4000 & ws://<host>:2567; trang https (tailscale serve)
# -> https://<host>:8443 & wss://<host>:10000. Giá trị localhost bên dưới tự bị bỏ qua khi mở trang từ máy khác/https.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WORLD_URL=ws://localhost:2567
# Voice chat P2P: mảng JSON RTCIceServer. Để trống khi chơi qua Tailscale/LAN (hai máy thấy nhau trực tiếp, không cần STUN/TURN).
# Chỉ thêm máy chủ STUN/TURN bạn tự chọn nếu thật sự cần, vd. [{"urls":"stun:stun.example.org:3478"}].
# Lưu ý: Next không nạp .env gốc; biến NEXT_PUBLIC_* của web đặt trong apps/web/.env.local hoặc shell trước khi chạy web.
NEXT_PUBLIC_VOICE_ICE_SERVERS=
# Không dùng khóa ví dụ trong môi trường production.
DEMO_JWT_SECRET=replace-this-with-a-private-random-secret-32-chars-min

# Thời gian cache (giây) cho /assets/* ở production. Được đọc lúc `next build` của web (Next không nạp .env gốc: đặt trong shell chạy build hoặc apps/web/.env.production). Mặc định 86400 (1 ngày). Dev không dùng.
ASSET_CACHE_MAX_AGE_SECONDS=86400
