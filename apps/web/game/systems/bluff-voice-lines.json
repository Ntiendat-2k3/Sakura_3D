  { "id": "reveal-truth-1", "group": "reveal-truth", "speaker": "dealer", "ja": "残念。本当でしたね。", "vi": "Tiếc quá. Là thật đấy." },
  { "id": "reveal-truth-2", "group": "reveal-truth", "speaker": "dealer", "ja": "正直者を疑うなんて、ひどい人。", "vi": "Nghi ngờ người thật thà, thật tệ." },
  { "id": "reveal-lie-1", "group": "reveal-lie", "speaker": "dealer", "ja": "あら、バレましたね。", "vi": "Ôi, lộ rồi nhé." },
  { "id": "reveal-lie-2", "group": "reveal-lie", "speaker": "dealer", "ja": "嘘は、高くつきますよ。", "vi": "Nói dối phải trả giá đắt đấy." },
  { "id": "shooting-1", "group": "shooting", "speaker": "dealer", "ja": "さあ、運命の時間です。", "vi": "Nào, giờ định mệnh." },
  { "id": "shooting-2", "group": "shooting", "speaker": "dealer", "ja": "引き金を、どうぞ。", "vi": "Mời bóp cò." },
  { "id": "click-1", "group": "click", "speaker": "dealer", "ja": "運がいいですね。", "vi": "May mắn đấy." },
  { "id": "click-2", "group": "click", "speaker": "dealer", "ja": "まだ、生きていますね。", "vi": "Vẫn còn sống nhỉ." },
  { "id": "bang-1", "group": "bang", "speaker": "dealer", "ja": "さようなら。", "vi": "Tạm biệt." },
  { "id": "bang-2", "group": "bang", "speaker": "dealer", "ja": "お気の毒に。", "vi": "Thật đáng tiếc." },
  { "id": "two-left-1", "group": "two-left", "speaker": "dealer", "ja": "残りは、お二人だけ。", "vi": "Chỉ còn hai người." },
  { "id": "two-left-2", "group": "two-left", "speaker": "dealer", "ja": "さあ、最後の二人です。", "vi": "Nào, hai người cuối cùng." },
  { "id": "winner-1", "group": "winner", "speaker": "dealer", "ja": "おめでとうございます。生き残ったのは、あなたです。", "vi": "Chúc mừng. Người sống sót là quý khách." },
  { "id": "winner-2", "group": "winner", "speaker": "dealer", "ja": "勝者に、乾杯を。", "vi": "Nâng ly chúc người thắng." },
  { "id": "taunt-flip-1", "group": "taunt-flip", "speaker": "taunt", "ja": "ざぁこ。", "vi": "Đồ gà." },
